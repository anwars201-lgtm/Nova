#!/data/user/0/com.androidharness.app/files/linux/bin/bash
# Wrapper jadx 1.5.6 untuk lingkungan Harness di Android.
#
# Kenapa wrapper ini ada:
#  1. Jar dipasang di $PREFIX/share/java/jadx-1.5.6-all.jar, bukan layout
#     standar (lib/) sehingga launcher bawaan gagal menemukan kelas.
#  2. Main class jar ini adalah jadx.gui.JadxGUI; GUI tidak berguna tanpa
#     display, jadi kita panggil jadx.cli.JadxCLI secara eksplisit.
#  3. Build Termux mengarahkan direktori konfigurasi ke /data/data/com.termux
#     yang tidak bisa ditulis di sini, jadi semua dir dialihkan.
#  4. Script di /storage/emulated tidak bisa dieksekusi langsung (mount noexec
#     untuk exec bit), jadi panggil dengan: bash bin/jadx ...
#
# Pemakaian: bash bin/jadx <file.apk> -d <output> --no-res
PREFIX="${PREFIX:-/data/user/0/com.androidharness.app/files/linux}"
PREFIX="${PREFIX%/usr}"
JAVA_HOME="${JAVA_HOME:-$PREFIX/lib/jvm/java-17-openjdk}"
export JAVA_HOME

# Direktori kerja jadx: pakai folder di dalam workspace bila ada.
if [ -n "$JADX_HOME" ]; then
    base="$JADX_HOME"
else
    base="$PWD/.harness/jadx"
fi
mkdir -p "$base/config" "$base/cache" "$base/tmp" "$base/home"
export JADX_CONFIG_DIR="$base/config"
export JADX_CACHE_DIR="$base/cache"
export JADX_TMP_DIR="$base/tmp"
export HOME="$base/home"

exec "$JAVA_HOME/bin/java" -Xmx3g -Djava.io.tmpdir="$base/tmp" \
    -cp "$PREFIX/share/java/jadx-1.5.6-all.jar" \
    jadx.cli.JadxCLI "$@"
